# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real credentials.
#
# Only needed if you're using the `stockoptions watchlist` command to pull
# tickers from your actual Robinhood account. Everything else (Greeks,
# strategy payoffs, IV screening on tickers you type in, the backtester)
# works with no credentials at all.
#
# Real risk, read the README before setting these: Robinhood has no
# official public API. This uses robin_stocks, which reverse-engineers
# their private app API -- that violates Robinhood's Terms of Service, and
# automated access (even read-only, which is all this project ever does)
# can still get an account flagged or suspended.

ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# Optional: your current 6-digit MFA code, if you have app-based 2FA set
# up. If left blank, robin_stocks will prompt for it interactively instead.
ROBINHOOD_MFA_CODE=

# ---------------------------------------------------------------------
# Optional: news & influencer tracking (news.py / social.py). None of
# this is required for anything else in the project, and none of it
# feeds the backtest model -- it's informational only. See the README's
# News section before turning any of this on.
# ---------------------------------------------------------------------

# Free key from https://finnhub.io -- powers the broad market-news feed
# and the influencer-mention search. Ticker-specific news (the default
# "News" panel) works with no key at all via yfinance.
FINNHUB_API_KEY=

# Optional; Truth Social account pulls (get_truth_social_posts) work with
# no login for reading a *public* account. Set these only for
# authenticated (higher rate-limit) access. Real risk, read the README:
# Truth Social has no official public API, and this uses truthbrush,
# which reverse-engineers their private app API -- same ToS-violation
# category as the Robinhood integration above.
TRUTHSOCIAL_USERNAME=
TRUTHSOCIAL_PASSWORD=

# Optional; a Nitter-style mirror URL for pulling X/Twitter posts, e.g.
# https://your-self-hosted-instance.example. Left blank by default
# because every public instance checked while building this was dead,
# rate-limited, or serving a gate page -- see social.py's module
# docstring. Only set this if you have a specific instance you've
# confirmed actually returns real posts right now.
NITTER_INSTANCE_URL=
